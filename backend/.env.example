# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

PORT=5000

# ---------- MySQL ----------
# Local:  DB_HOST=localhost, DB_PORT=3306, DB_SSL=false
# Cloud (Aiven): host/port/user/password from the Aiven console, DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_qa_app
DB_SSL=false
# Cloud only: path to the CA certificate file (or paste it in DB_SSL_CA)
# DB_SSL_CA_FILE=/etc/secrets/ca.pem

# Any long random string (used to sign login tokens)
JWT_SECRET=change_this_to_a_long_random_string

# ---------- Google Gemini ----------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Maximum PDFs per student (keep small on a free 1 GB database)
MAX_DOCS=20
